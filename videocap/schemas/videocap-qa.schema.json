{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savebees.github.io/VideoCap/schemas/videocap-qa-v0.1.json",
  "title": "VideoCap Grounded QA Record",
  "type": "object",
  "required": ["schema_version", "video_id", "split", "examples"],
  "properties": {
    "schema_version": {"const": "videocap-qa/v0.1"},
    "video_id": {"type": "string", "minLength": 1},
    "split": {"type": "string", "minLength": 1},
    "examples": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["qa_id", "task", "question", "answer", "provenance"],
        "properties": {
          "qa_id": {"type": "string", "minLength": 1},
          "task": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "answer": {"type": "string", "minLength": 1},
          "provenance": {
            "type": "object",
            "required": ["event_ids", "evidence_frames_ms"],
            "properties": {
              "event_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "evidence_frames_ms": {"type": "array", "items": {"type": "integer", "minimum": 0}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
