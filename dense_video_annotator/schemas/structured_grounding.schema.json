{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savebees.github.io/dense-video-annotator/schemas/structured-grounding-v0.1.json",
  "title": "Structured Grounding Final Record",
  "type": "object",
  "required": ["schema_version", "video_id", "duration_ms", "captions", "events", "quality"],
  "properties": {
    "schema_version": {"const": "structured-grounding/v0.1"},
    "video_id": {"type": "string", "minLength": 1},
    "duration_ms": {"type": "integer", "minimum": 1},
    "captions": {
      "type": "object",
      "required": ["short", "main_object", "background", "camera", "detailed"],
      "properties": {
        "short": {"type": "string", "minLength": 1},
        "main_object": {"type": "string", "minLength": 1},
        "background": {"type": "string", "minLength": 1},
        "camera": {"type": "string", "minLength": 1},
        "detailed": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_id", "cluster_id", "start_ms", "end_ms", "evidence_frames_ms", "caption"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "cluster_id": {"type": "string", "minLength": 1},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1},
          "evidence_frames_ms": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
          "caption": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "quality": {"type": "object"}
  },
  "additionalProperties": false
}
