{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savebees.github.io/VideoCap/schemas/videocap-eval-v0.1.json",
  "title": "VideoCap Evaluation Report",
  "type": "object",
  "required": ["schema_version", "split", "thresholds", "videos", "accepted", "aggregate", "records"],
  "properties": {
    "schema_version": {"const": "videocap-eval/v0.1"},
    "split": {"type": "string", "minLength": 1},
    "thresholds": {"type": "object", "additionalProperties": {"type": "number"}},
    "videos": {"type": "integer", "minimum": 1},
    "accepted": {"type": "integer", "minimum": 0},
    "aggregate": {"type": "object", "additionalProperties": {"type": "number"}},
    "records": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "additionalProperties": false
}
