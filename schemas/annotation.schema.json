{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Dense Video Annotation",
  "description": "Actions may overlap and do not need to cover the full scene duration.",
  "type": "object",
  "required": ["video_id", "duration", "fps", "resolution", "codec", "file_size_mb", "segments", "metadata"],
  "properties": {
    "video_id": {"type": "string"},
    "duration": {"type": "number", "minimum": 0},
    "fps": {"type": "number", "minimum": 0},
    "resolution": {"type": "string", "pattern": "^\\d+x\\d+$"},
    "codec": {"type": "string"},
    "file_size_mb": {"type": "number", "minimum": 0},
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene_id", "start", "end", "brief", "description", "word_count", "actions", "objects"],
        "properties": {
          "scene_id": {"type": "integer", "minimum": 1},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "brief": {"type": "string"},
          "description": {"type": "string"},
          "word_count": {"type": "integer", "minimum": 0},
          "actions": {
            "type": "array",
            "description": "Visual actions by salient subjects. May overlap; gaps allowed.",
            "items": {
              "type": "object",
              "required": ["action_id", "start", "end", "subject", "description"],
              "properties": {
                "action_id": {"type": "integer", "minimum": 1},
                "start": {"type": "number", "minimum": 0},
                "end": {"type": "number", "minimum": 0},
                "subject": {"type": "string"},
                "description": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["object_id", "label", "bbox", "confidence", "frame_index"],
              "properties": {
                "object_id": {"type": "integer", "minimum": 1},
                "label": {"type": "string"},
                "bbox": {
                  "type": "array",
                  "items": {"type": "number"},
                  "minItems": 4,
                  "maxItems": 4
                },
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "frame_index": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "required": ["generated_at", "models", "total_segments", "avg_segment_duration", "total_actions", "avg_actions_per_segment", "total_objects"],
      "properties": {
        "generated_at": {"type": "string"},
        "models": {
          "type": "object",
          "properties": {
            "vlm": {"type": "string"},
            "detector": {"type": "string"}
          }
        },
        "total_segments": {"type": "integer"},
        "avg_segment_duration": {"type": "number"},
        "total_actions": {"type": "integer"},
        "avg_actions_per_segment": {"type": "number"},
        "total_objects": {"type": "integer"},
        "step1_raw_segments": {"type": "integer"},
        "step2_repairs": {"type": "integer"}
      }
    }
  },
  "additionalProperties": false
}
